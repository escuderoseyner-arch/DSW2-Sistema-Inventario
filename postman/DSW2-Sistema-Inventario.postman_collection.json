{
  "info": {
    "_postman_id": "b3e7f2c1-4a5d-4e8f-9c0a-1b2c3d4e5f60",
    "name": "DSW2 Sistema de Inventarios",
    "description": "Coleccion generada desde los requests de las carpetas postman/collections (Categoria y Productos).\nLa clave del stock minimo es stockMinimo (coincide con el DTO/entidad).\nAntes de usar: levanta la app (puerto 8080) y crea primero una categoria para tener un idCategoria valido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Categoria",
      "item": [
        {
          "name": "Hacer Nueva Categoria",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Electronica\",\n  \"descripcion\": \"Productos electronicos\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categorias"]
            }
          }
        },
        {
          "name": "Listar Categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categorias"]
            }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar Productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            }
          }
        },
        {
          "name": "Hacer Nuevo Producto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Monitor LG 24\",\n  \"descripcion\": \"Monitor LED Full HD\",\n  \"precio\": 850.50,\n  \"stock\": 10,\n  \"stockMinimo\": 2,\n  \"idCategoria\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            }
          }
        },
        {
          "name": "Buscar Producto Segun Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "1"]
            }
          }
        },
        {
          "name": "Buscar Productos Segun Categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/categoria/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "categoria", "1"]
            }
          }
        },
        {
          "name": "Actualizar Producto",
          "request": {
            "description": "OJO: el PUT no modifica el stock (solo se define al registrar). Este cuerpo manda stock=5 pero se ignora a proposito.",
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Monitor LG 27\",\n  \"descripcion\": \"Ahora de 27 pulgadas\",\n  \"precio\": 990.00,\n  \"stock\": 5,\n  \"stockMinimo\": 3,\n  \"idCategoria\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "1"]
            }
          }
        },
        {
          "name": "Eliminar Producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "1"]
            }
          }
        }
      ]
    }
  ]
}
